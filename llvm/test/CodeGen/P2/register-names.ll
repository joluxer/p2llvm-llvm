; NOTE: Automatically generated by gen_register_names_test.py.
; To regenerate: python3 gen_register_names_test.py > register-names.ll
; RUN: llc -march=p2 < %s | FileCheck %s
; REQUIRES: p2-registered-target

; Tests that all P2 COG-RAM register names (c0-c463) and named
; special-purpose registers are accepted as inline asm operands
; in both source and destination positions.

; -----------------------------------------------------------------------
; COG-RAM registers c0-c463: write (destination) and read (source)
; -----------------------------------------------------------------------

define void @write_c0(i32 %val) {
; CHECK-LABEL: write_c0:
; CHECK: mov c0, {{r[0-9]+}}
    call void asm sideeffect "mov c0, $0", "r"(i32 %val) nounwind
    ret void
}

define i32 @read_c0() {
; CHECK-LABEL: read_c0:
; CHECK: mov {{r[0-9]+}}, c0
    %val = call i32 asm sideeffect "mov $0, c0", "=r"() nounwind
    ret i32 %val
}

